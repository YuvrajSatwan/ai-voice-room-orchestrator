# ─────────────────────────────────────────────────────────────────────────────
# ROXSTAR AI Voice Room Assistant — environment configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to source control.
# Every variable below is read by src/roxstar/config.py (or server.py / token_server.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── LiveKit (required) ───────────────────────────────────────────────────────
# Rooms and audio transport. From https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Sarvam AI (required for voice) ───────────────────────────────────────────
# Speech-to-text (Saaras v3) and text-to-speech (Bulbul v3). From https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=codemix         # Hinglish: Hindi words in Devanagari, English words in Latin

# ── Google Gemini (required) ─────────────────────────────────────────────────
# Replies and the rolling summary. From https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite              # default: fast, no hidden "thinking" tokens
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest  # used automatically if the main model fails

# ── Logging ──────────────────────────────────────────────────────────────────
ROXSTAR_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
ROXSTAR_LOG_FORMAT=text            # text (readable) or json (machine-parsable)
# ROXSTAR_LOG_TRANSCRIPTS=true     # also log what was said / replied (off by default for privacy)

# ── Demo only ────────────────────────────────────────────────────────────────
# Lets a chat message "/fail llm" or "/fail tts" make the NEXT call fail on purpose,
# to show failure handling on camera. Leave off otherwise.
# ROXSTAR_DEMO_CONTROLS=true

# ── Token server (optional) ──────────────────────────────────────────────────
# HOST=0.0.0.0                     # default; use 127.0.0.1 to keep it local-only
# PORT=8000                        # default; hosts like Render set this for you
