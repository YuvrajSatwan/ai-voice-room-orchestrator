# ─────────────────────────────────────────────────────────────────────────────
# ROXSTAR AI Voice Room Assistant — environment configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LiveKit ───────────────────────────────────────────────────────────────────
# Required. Obtain from https://cloud.livekit.io or your self-hosted instance.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Speech providers ─────────────────────────────────────────────────────────
# Sarvam AI: STT (Saarika v2) and TTS (Bulbul v3 — required for Hindi/Hinglish)
# Obtain from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key

# ── LLM provider ─────────────────────────────────────────────────────────────
# Google Gemini: LLM (Gemini 3 Flash / Gemini 2.5 Flash)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI LLM fallback
OPENAI_API_KEY=your_openai_api_key

# ── Runtime ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
ROXSTAR_LOG_LEVEL=INFO

# Log format: json (for production/parsing) | text (for local development)
ROXSTAR_LOG_FORMAT=text

# ── Optional tuning ───────────────────────────────────────────────────────────
# LLM hard timeout in seconds (default: 20)
# ROXSTAR_LLM_TIMEOUT_SECONDS=20

# Max recent turns kept in room context (default: 12)
# ROXSTAR_MAX_RECENT_TURNS=12

# Max facts per human participant (default: 8)
# ROXSTAR_MAX_FACTS_PER_SPEAKER=8

# ElevenLabs (TTS evaluation / optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
